# Local SQLite path. Default: ./data/simplesequence.db
DATABASE_URL=file:./data/simplesequence.db

# Hosted MCP. Local default is fine for Codex/Cursor.
MCP_API_KEY=dev-mcp-key

# Unipile — leave unset to keep MockUnipile / sandbox dry-run.
# UNIPILE_API_KEY=
# UNIPILE_DSN=

# Optional later: real login + hosted Postgres.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
